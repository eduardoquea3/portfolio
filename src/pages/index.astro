---
import AboutSection from '../components/AboutSection.astro';
import ContactSection from '../components/ContactSection.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TechSection from '../components/TechSection.astro';
import '../styles/global.css';
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Portfolio de Eduardo Quea Hancco, Full Stack Developer especializado en aplicaciones web, APIs y bases de datos." />
		<meta name="generator" content={Astro.generator} />
		<title>Eduardo Quea Hancco — Full Stack Developer</title>
	</head>
	<body>
		<div class="grain" aria-hidden="true"></div>
		<Header />
		<main>
			<Hero />
			<AboutSection />
			<TechSection />
			<ProjectsSection />
			<ContactSection />
		</main>
		<SiteFooter />
		<script>
			import { gsap } from 'gsap';
			import { ScrollTrigger } from 'gsap/ScrollTrigger';

			gsap.registerPlugin(ScrollTrigger);

			const motion = gsap.matchMedia();
			motion.add('(prefers-reduced-motion: no-preference)', () => {
				const hoverCleanups: Array<() => void> = [];
				const context = gsap.context(() => {
					const hero = document.querySelector('[data-motion="hero"]');
					if (hero) {
						const intro = gsap.timeline({ defaults: { ease: 'power3.out' } });
						intro
							.from(hero.querySelector('[data-motion="hero-copy"]'), { autoAlpha: 0, y: 36, duration: 0.9 })
							.from(hero.querySelector('[data-motion="hero-intro"]'), { autoAlpha: 0, y: 24, duration: 0.75 }, '-=0.55');
					}

					const title = hero?.querySelector<HTMLElement>('[data-motion="hero-title"]');
					const titleLines = title?.querySelectorAll<HTMLElement>('[data-motion="hero-title-line"]');
					const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
					if (title && titleLines && canHover) {
						const onPointerEnter = () => {
							gsap.to(titleLines[0], { y: -5, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
							gsap.to(titleLines[1], { y: -5, scale: 1.035, textShadow: '0 0 28px rgba(104, 169, 255, 0.28)', duration: 0.35, ease: 'power2.out', overwrite: 'auto' });
						};
						const onPointerLeave = () => gsap.to(titleLines, {
							y: 0,
							scale: 1,
							textShadow: '0 0 0 rgba(104, 169, 255, 0)',
							duration: 0.4,
							ease: 'power2.out',
							overwrite: 'auto',
						});

						title.addEventListener('pointerenter', onPointerEnter);
						title.addEventListener('pointerleave', onPointerLeave);
						hoverCleanups.push(() => {
							title.removeEventListener('pointerenter', onPointerEnter);
							title.removeEventListener('pointerleave', onPointerLeave);
							gsap.killTweensOf(titleLines);
						});
					}

					gsap.utils.toArray<HTMLElement>('[data-motion="interactive"]').forEach((element) => {
						const icon = element.querySelector<HTMLElement>('[data-motion="interactive-icon"]');
						const animateIn = () => {
							gsap.to(element, { y: -3, scale: 1.025, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
							if (icon) gsap.to(icon, { y: -2, scale: 1.18, rotation: 8, duration: 0.25, ease: 'back.out(1.7)', overwrite: 'auto' });
						};
						const animateOut = () => {
							gsap.to(element, { y: 0, scale: 1, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
							if (icon) gsap.to(icon, { y: 0, scale: 1, rotation: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
						};
						if (canHover) {
							element.addEventListener('pointerenter', animateIn);
							element.addEventListener('pointerleave', animateOut);
						}
						element.addEventListener('focus', animateIn);
						element.addEventListener('blur', animateOut);
						hoverCleanups.push(() => {
							if (canHover) {
								element.removeEventListener('pointerenter', animateIn);
								element.removeEventListener('pointerleave', animateOut);
							}
							element.removeEventListener('focus', animateIn);
							element.removeEventListener('blur', animateOut);
							gsap.killTweensOf(element);
							if (icon) gsap.killTweensOf(icon);
						});
					});

					if (canHover) {
						gsap.utils.toArray<HTMLElement>('[data-motion="technology-item"]').forEach((item) => {
							const icon = item.querySelector<HTMLElement>('[data-motion="technology-icon"]');
							const title = item.querySelector<HTMLElement>('h4');
							const iconBase = icon ? getComputedStyle(icon).backgroundColor : '';
							const titleBase = title ? getComputedStyle(title).color : '';
							const onEnter = () => {
								gsap.to(item, { x: 5, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
								if (icon) gsap.to(icon, { scale: 1.08, rotation: 4, backgroundColor: 'rgba(104, 169, 255, 0.2)', duration: 0.3, ease: 'back.out(1.7)', overwrite: 'auto' });
								if (title) gsap.to(title, { color: '#68a9ff', duration: 0.2, ease: 'power1.out', overwrite: 'auto' });
							};
							const onLeave = () => {
								gsap.to(item, { x: 0, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
								if (icon) gsap.to(icon, { scale: 1, rotation: 0, backgroundColor: iconBase, duration: 0.3, ease: 'power2.out', overwrite: 'auto' });
								if (title) gsap.to(title, { color: titleBase, duration: 0.2, ease: 'power1.out', overwrite: 'auto' });
							};
							item.addEventListener('pointerenter', onEnter);
							item.addEventListener('pointerleave', onLeave);
							hoverCleanups.push(() => {
								item.removeEventListener('pointerenter', onEnter);
								item.removeEventListener('pointerleave', onLeave);
								gsap.killTweensOf(item);
								if (icon) gsap.killTweensOf(icon);
								if (title) gsap.killTweensOf(title);
							});
						});
					}

					gsap.utils.toArray<HTMLElement>('[data-motion="about"], [data-motion="technology"], [data-motion="projects"], [data-motion="contact"]').forEach((section) => {
						const name = section.dataset.motion;
						const heading = section.querySelector<HTMLElement>(`[data-motion="${name}-content"], [data-motion="${name}-heading"], [data-motion="contact-cta"]`);
						if (heading) {
							gsap.from(heading, {
								autoAlpha: 0,
								x: name === 'projects' ? 28 : 0,
								y: name === 'projects' ? 0 : 34,
								duration: 0.8,
								ease: 'power3.out',
								scrollTrigger: { trigger: heading, start: 'top 82%', once: true },
							});
						}
					});

					gsap.utils.toArray<HTMLElement>('[data-motion="technology-category"]').forEach((category) => {
						const items = category.querySelectorAll(':scope > div > div');
						gsap.from(items, {
							autoAlpha: 0,
							y: 22,
							stagger: 0.055,
							duration: 0.55,
							ease: 'power2.out',
							scrollTrigger: { trigger: category, start: 'top 84%', once: true },
						});
					});

					gsap.from('[data-motion="project-card"]', {
						autoAlpha: 0,
						y: 38,
						rotationX: 4,
						transformOrigin: 'center bottom',
						stagger: 0.16,
						duration: 0.85,
						ease: 'power3.out',
						scrollTrigger: { trigger: '[data-motion="projects"]', start: 'top 72%', once: true },
					});

					gsap.from('[data-motion="contact-details"] > *', {
						autoAlpha: 0,
						y: 18,
						stagger: 0.12,
						duration: 0.6,
						ease: 'power2.out',
						scrollTrigger: { trigger: '[data-motion="contact-details"]', start: 'top 88%', once: true },
					});
				});

				return () => {
					hoverCleanups.forEach((cleanup) => cleanup());
					context.revert();
				};
			});
		</script>
	</body>
</html>
