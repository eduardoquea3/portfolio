---
import SectionLabel from './SectionLabel.astro';
---

<section class="mx-auto w-[min(1120px,calc(100%-64px))] border-t border-line pb-[78px] pt-[25px] max-md:w-[calc(100%-40px)]" id="contacto">
	<SectionLabel number="04" label="Contacto" />
	<div class="ml-[16.5%] mb-[130px] mt-[95px] max-md:ml-0 max-md:mb-[90px] max-md:mt-[70px]"><p class="mb-[29px] font-mono text-[.68rem] font-medium uppercase tracking-[.04em] text-lime">Contacto</p><h2 class="font-display text-[clamp(3.5rem,7vw,6.9rem)] font-semibold leading-[.98] tracking-[-.08em]">¿Tenés una idea?<br /><em class="not-italic text-lime">Escribime.</em></h2><a class="mt-[53px] inline-block border-b border-[#687065] pb-[10px] font-mono text-base font-medium transition-colors hover:text-lime" href="mailto:eduardoquea3@gmail.com">eduardoquea3@gmail.com <span class="ml-1 text-lime">↗</span></a></div>
	<div class="ml-[16.5%] flex justify-between border-t border-line pt-[25px] font-mono text-[.63rem] uppercase text-[#92988c] max-md:ml-0 max-md:grid max-md:grid-cols-2 max-md:gap-[35px]"><div class="flex flex-col gap-[11px]"><span class="mb-[3px] text-[#697065]">Mis perfiles</span><a class="text-ink" href="https://github.com/eduardoquea3" target="_blank" rel="noreferrer">GitHub ↗</a></div><div class="flex flex-col gap-[11px]"><span class="mb-[3px] text-[#697065]">Correo</span><a class="text-ink normal-case" href="mailto:eduardoquea3@gmail.com">eduardoquea3@gmail.com</a></div><span class="self-end text-[#687065] max-md:col-span-full max-md:self-auto">© {new Date().getFullYear()} Eduardo Quea Hancco</span></div>
</section>
