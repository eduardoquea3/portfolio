---
import SectionLabel from './SectionLabel.astro';

const projects = [
	{ number: '01', title: 'Nexus Studio', description: 'Gestor de bases de datos de escritorio para conectarse a PostgreSQL, MySQL y SQLite.', tags: ['Tauri', 'React', 'Rust', 'SQL'], color: 'bg-lime text-page', symbol: '⌘', url: 'https://github.com/eduardoquea3/nexus-studio' },
	{ number: '02', title: 'Tempo', description: 'Proyecto de escritorio desarrollado con Tauri, React y TypeScript.', tags: ['Tauri', 'React', 'TypeScript'], color: 'bg-[#d95d42] text-page', symbol: '◷', url: 'https://github.com/eduardoquea3/tempo' },
];
---

<section class="mx-auto w-[min(1120px,calc(100%-64px))] border-t border-line pb-[170px] pt-[25px] max-md:w-[calc(100%-40px)] max-md:pb-[100px]" id="proyectos">
	<SectionLabel number="03" label="Proyectos" />
	<div class="ml-[16.5%] mt-[70px] mb-[55px] flex items-end justify-between max-md:ml-0 max-md:mt-[50px] max-md:mb-[35px] max-md:block"><h2 class="font-display text-[clamp(2.7rem,5vw,5rem)] font-semibold leading-[.98] tracking-[-.08em]">Proyectos<br /><span class="text-lime">que construí.</span></h2><a class="font-mono text-[.7rem] font-medium text-ink transition-colors hover:text-lime max-md:mt-[25px] max-md:inline-block" href="#contacto">Hablemos de tu proyecto <span class="ml-1 text-lime">↗</span></a></div>
	<div class="ml-[16.5%] grid grid-cols-2 gap-[18px] max-md:ml-0 max-md:grid-cols-1 max-md:gap-[45px]">
		{projects.map((project) => <article><a class="group block" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Ver ${project.title} en GitHub (abre en una nueva pestaña)`}><div class={`relative flex h-[280px] items-center justify-center overflow-hidden p-[17px] max-md:h-[250px] ${project.color}`}><span class="absolute left-[17px] top-[17px] font-mono text-[.61rem]">{project.number}</span><div class="font-display text-[7rem] leading-[.8] transition-transform group-hover:scale-110">{project.symbol}</div><span class="absolute bottom-[17px] right-[17px] font-mono text-[.61rem]">Ver repositorio <b class="ml-[9px] text-base">↗</b></span></div></a><div class="pt-[21px]"><h3 class="font-display text-[1.35rem] font-semibold">{project.title}</h3><p class="my-[11px] max-w-[390px] text-[.78rem] leading-[1.55] text-[#90968a]">{project.description}</p><div class="flex flex-wrap gap-[7px]">{project.tags.map((tag) => <span class="border border-[#3b4436] px-2 py-[5px] font-mono text-[.59rem] text-[#9da398]">{tag}</span>)}</div></div></article>)}
	</div>
</section>
