---
import SectionLabel from './SectionLabel.astro';

const technologyIcons: Record<string, string> = {
	Tauri: 'https://svgl.app/library/tauri.svg',
	React: 'https://svgl.app/library/react_dark.svg',
	Rust: 'https://svgl.app/library/rust_dark.svg',
	PostgreSQL: 'https://svgl.app/library/postgresql.svg',
	MySQL: 'https://svgl.app/library/mysql-icon-dark.svg',
	SQLite: '/icons/sqlite.svg',
	TypeScript: 'https://svgl.app/library/typescript.svg',
};

const projects = [
	{ number: '01', title: 'Nexus Studio', description: 'Gestor de bases de datos de escritorio para conectarse a PostgreSQL, MySQL y SQLite.', technologies: ['Tauri', 'React', 'Rust', 'PostgreSQL', 'MySQL', 'SQLite'], color: 'bg-lime text-page', symbol: '⌘', url: 'https://github.com/eduardoquea3/nexus-studio' },
	{ number: '02', title: 'Tempo', description: 'Proyecto de escritorio desarrollado con Tauri, React y TypeScript.', technologies: ['Tauri', 'React', 'TypeScript'], color: 'bg-[#d95d42] text-page', symbol: '◷', url: 'https://github.com/eduardoquea3/tempo' },
];
---

<section data-motion="projects" class="mx-auto w-[min(1120px,calc(100%-64px))] border-t border-line pb-[170px] pt-[25px] max-md:w-[calc(100%-40px)] max-md:pb-[100px]" id="proyectos">
	<SectionLabel number="03" label="Proyectos" />
	<div data-motion="projects-heading" class="ml-[16.5%] mt-[70px] mb-[55px] flex items-end justify-between max-md:ml-0 max-md:mt-[50px] max-md:mb-[35px] max-md:block"><h2 class="font-display text-[clamp(2.7rem,5vw,5rem)] font-semibold leading-[.98] tracking-[-.08em]">Proyectos<br /><span class="text-lime">que construí.</span></h2><a data-motion="interactive" class="font-mono text-[.8rem] font-medium text-ink transition-colors hover:text-lime focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-lime max-md:mt-[25px] max-md:inline-block" href="#contacto">Hablemos de tu proyecto <span class="ml-1 text-lime">↗</span></a></div>
	<div class="ml-[16.5%] grid grid-cols-2 gap-[18px] max-md:ml-0 max-md:grid-cols-1 max-md:gap-[45px]">
		{projects.map((project) => <article data-motion="project-card"><a class="group block" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Ver ${project.title} en GitHub (abre en una nueva pestaña)`}><div class={`relative flex h-[280px] items-center justify-center overflow-hidden p-[17px] max-md:h-[250px] ${project.color}`}><span class="absolute left-[17px] top-[17px] font-mono text-[.61rem]">{project.number}</span><div class="font-display text-[7rem] leading-[.8] transition-transform group-hover:scale-110">{project.symbol}</div><span class="absolute bottom-[17px] right-[17px] font-mono text-[.72rem]">Ver repositorio <b class="ml-[9px] inline-block text-[1.15rem] leading-none">↗</b></span></div></a><div class="pt-[21px]"><h3 class="font-display text-[1.35rem] font-semibold">{project.title}</h3><p class="my-[11px] max-w-[390px] text-[.78rem] leading-[1.55] text-[#90968a]">{project.description}</p><div role="list" aria-label={`Tecnologías utilizadas en ${project.title}`} class="flex flex-wrap items-center gap-3">{project.technologies.map((technology) => <span role="listitem" title={technology}><img class="h-8 w-8 object-contain" src={technologyIcons[technology]} alt={technology} loading="lazy" /></span>)}</div></div></article>)}
	</div>
</section>
